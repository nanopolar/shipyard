# Password for the Shipyard web UI login form
AGENT_PASSWORD=change-me-to-something-secure

# Random string to sign session cookies - generate with: openssl rand -hex 32
SESSION_SECRET=change-me-random-secret

# API key used by MCP clients (claude.ai) and the browser extension
# Generate with: openssl rand -hex 32
AGENT_API_KEY=change-me-api-key

# ntfy.sh topic - pick something unique e.g. "yourname-deploys-x7k2"
# Subscribe to this topic in the ntfy mobile app
NTFY_TOPIC=your-unique-topic-name

# ntfy server (leave as-is unless you self-host ntfy)
NTFY_URL=https://ntfy.sh

# Absolute path on the HOST where deployed projects live.
# Must be the same path inside and outside the container - see docker-compose.yml.
# Create this directory before starting: sudo mkdir -p /opt/shipyard-agent/deployments
DEPLOYMENTS_DIR=/opt/shipyard-agent/deployments

# Port for the web UI
PORT=3000
